# ====== 应用 ======
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*

# ====== 大模型 (OpenAI 兼容协议) ======
# 华为内部大模型 / 外部 API / 本地 Ollama 均走同一协议，改 BASE_URL 即可切换
# Ollama:    http://localhost:11434/v1   api_key=ollama
# 华为内部:  <内部网关>/v1               api_key=<ak/sk>
# 外部 API:  https://api.openai.com/v1   api_key=sk-...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.3

# ====== 向量/Embedding ======
# provider: api(走 OpenAI 兼容 /embeddings) | local(本地 sentence-transformers,需 pip install sentence-transformers)
EMBED_PROVIDER=api
EMBED_BASE_URL=                      # 留空则复用 LLM_BASE_URL
EMBED_API_KEY=                        # 留空则复用 LLM_API_KEY
EMBED_MODEL=BAAI/bge-small-zh-v1.5   # local 模式用;api 模式按网关支持填写(如 text-embedding-3-small)

# ====== CodeHub (华为内部代码仓, GitLab v4 兼容协议) ======
CODEHUB_BASE_URL=https://codehub.example.com
CODEHUB_TOKEN=                       # 私有 token;留空且 MOCK=true 时使用内置样例
CODEHUB_API_PREFIX=/api/v4
CODEHUB_MOCK=true                    # 无 token 时用内置样例 MR,便于本地离线体验

# ====== 知识库存储 ======
DATA_DIR=data
CHROMA_PATH=data/chroma
SQLITE_PATH=data/db.sqlite
UPLOAD_DIR=data/uploads

# ====== 业界最佳实践探索 ======
# provider: none(仅 LLM+本地实践库) | ddgs(免费,需 pip install ddgs) | tavily(需 key)
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
