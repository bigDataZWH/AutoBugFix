{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v3",
  "provider": {
    "huawei-maas": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${LLM_BINDING_HOST}",
        "apiKey": "${LLM_BINDING_API_KEY}",
        "headers": {
          "X-Auth-Type": "AK/SK"
        }
      },
      "models": {
        "deepseek-v3": {
          "name": "DeepSeek V3"
        },
        "qwen2.5-coder": {
          "name": "Qwen2.5 Coder"
        }
      }
    }
  },
  "embedding": {
    "provider": "huawei-maas",
    "model": "bge-m3",
    "dim": 1024
  },
  "plugin": [
    "opencode-codegraph"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "mcp"],
      "enabled": true,
      "environment": {
        "CODEGRAPH_DB": "./.codegraph/graph.db"
      }
    }
  },
  "agent": {
    "edit": {
      "model": "deepseek-v3",
      "tools": ["codegraph"]
    },
    "extract": {
      "model": "qwen2.5-coder",
      "tools": ["codegraph"]
    }
  }
}
